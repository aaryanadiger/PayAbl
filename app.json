{
  "expo": {
    "name": "Payabl",
    "slug": "payabl",
    "version": "1.0.0",
    "scheme": "payabl",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "buildNumber": "2",
      "supportsTablet": false,
      "bundleIdentifier": "com.payabl.prototype",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Payabl to turn your spoken contact name or amount into text.",
        "NSMicrophoneUsageDescription": "Allow Payabl to hear the contact name or payment amount you choose to speak."
      }
    },
    "android": {
      "versionCode": 2,
      "package": "com.payabl.prototype",
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"],
      "adaptiveIcon": {
        "backgroundColor": "#101010",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Payabl to scan UPI payment QR codes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-router",
      "expo-font",
      "./plugins/withVoiceShortcut",
      ["expo-contacts", { "contactsPermission": "Allow Payabl to import contact names and phone numbers for choosing a payment recipient. Contacts stay on this device." }],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Payabl to hear the contact name or payment amount you choose to speak.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.tts"],
          "speechRecognitionPermission": "Allow Payabl to turn your spoken contact name or amount into text."
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "160e67dc-2e5d-4cd0-8d2a-cc50d94a785e"
      }
    },
    "owner": "ndverano"
  }
}
